
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Comprehensive inventory item with variants and financial details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "buyingPrice": { "type": "number" },
        "sellingPriceRetail": { "type": "number" },
        "sellingPriceWholesale": { "type": "number" },
        "minStock": { "type": "number" },
        "currentStock": { "type": "number" },
        "reorderQty": { "type": "number" },
        "supplier": { "type": "string" },
        "locationBin": { "type": "string" },
        "hasSerialNumber": { "type": "boolean" },
        "warrantyPeriod": { "type": "string" },
        "imageUrl": { "type": "string" },
        "taxStatus": { "type": "string", "enum": ["Taxable", "Exempt", "ZeroRated"] },
        "variants": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" },
              "sku": { "type": "string" },
              "priceAdjustment": { "type": "number" }
            }
          }
        }
      }
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Audit trail record for every stock level change.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "productId": { "type": "string" },
        "type": { "type": "string", "enum": ["PURCHASE", "STOCK IN", "SALE", "STOCK OUT", "ADJUSTMENT", "DAMAGED", "RETURNED", "CUSTOMER RETURN", "SUPPLIER RETURN"] },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdBy": { "type": "object" }
      }
    },
    "Company": {
      "title": "Company",
      "description": "Represents a business workspace/tenant.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "object" }
      }
    },
    "Customer": {
      "title": "Customer",
      "description": "Client record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "registrationDate": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "#/backend/entities/Company",
      "description": "Global workspace records."
    },
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Inventory products siloed by tenantId."
    },
    "/stock_movements/{movementId}": {
      "schema": "#/backend/entities/StockMovement",
      "description": "Audit trail of stock changes."
    },
    "/customers/{customerId}": {
      "schema": "#/backend/entities/Customer",
      "description": "Customer CRM siloed by tenantId."
    },
    "/users/{userId}": {
      "schema": {
        "title": "User",
        "type": "object",
        "properties": {
          "tenantId": { "type": "string" },
          "tenantIds": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "description": "User profiles with multi-tenant links."
    }
  }
}
